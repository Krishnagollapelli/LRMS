# ==============================================================================
# LABORATORY REPORT MANAGEMENT SYSTEM (LRMS) ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection URL
# - Local SQLite: "file:./lrms.db"
# - Production PostgreSQL: "postgresql://user:password@host:5432/database"
DATABASE_URL="file:./lrms.db"

# Express API Port
PORT=5000

# Security Secret for signing JWT tokens (highly recommended to change in production)
JWT_SECRET="supersecretjwtkey123!lrms"

# System Node Environment (development | production)
NODE_ENV="development"

# Client API Base URL Override (Optional)
# If left blank, the frontend automatically resolves the API path relative to the browser origin
# VITE_API_URL="http://localhost:5000/api"
