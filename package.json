{
  "name": "lrms-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Laboratory Report Management System (LRMS) Workspace",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "db:generate": "node scripts/prepare-db.js && prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "node scripts/prepare-db.js && prisma migrate dev --schema=./prisma/schema.prisma",
    "db:deploy": "node scripts/prepare-db.js && prisma migrate deploy --schema=./prisma/schema.prisma",
    "install:all": "npm install && npm run db:generate",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "build:web": "npm run build:client && npm run build:server",
    "build": "npm run build:web",
    "start:server": "npm run start -w server",
    "start": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "vercel-build": "npm run db:generate && npm run build:client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.14.0",
    "typescript": "^5.4.5"
  }
}
